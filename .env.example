# Frontend environment variables (Vite)
# Copy this file to .env and fill in your real values.
# Never commit .env to git — it is listed in .gitignore.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Found in: Supabase dashboard → Project Settings → API

# Your project URL (e.g. https://abcdefghij.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Anon/public key — safe to expose in the browser (RLS enforces security)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Backend (Render) ──────────────────────────────────────────────────────────
# The URL of your deployed Express backend on Render
# For local development: http://localhost:8080
# For production: https://railaurum-backend.onrender.com
VITE_BACKEND_URL=http://localhost:8080
