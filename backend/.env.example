# Backend environment variables for Spring Boot (Render)
# Copy this file to .env or set them in your IDE/Render.

# ── Database (JDBC) ───────────────────────────────────────────────────────────
# From Supabase Dashboard -> Database -> Connection String -> JDBC
SPRING_DATASOURCE_URL=jdbc:postgresql://db.your-project.supabase.co:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your-database-password

# ── Supabase Auth ─────────────────────────────────────────────────────────────
# From Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# JWT Secret is required for Spring Security to validate the tokens locally (HS256)
SUPABASE_JWT_SECRET=your-jwt-secret-here

# ── CORS ──────────────────────────────────────────────────────────────────────
# Your Vercel frontend URL
FRONTEND_URL=https://your-frontend.vercel.app
