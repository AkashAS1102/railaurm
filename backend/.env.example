# Backend environment variables for Render
# Copy this file to .env and fill in your real values.
# Never commit .env to git.

# Supabase project URL (from Supabase dashboard → Project Settings → API)
SUPABASE_URL=https://your-project-id.supabase.co

# Service role key — KEEP SECRET! Bypasses RLS. Never expose to browser.
# Found in Supabase dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# The Vercel frontend URL for CORS (e.g. https://railaurum.vercel.app)
FRONTEND_URL=https://your-frontend.vercel.app

# Port (Render sets this automatically — leave as-is)
# PORT=3001
